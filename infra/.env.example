# ─── General ──────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ─── Base de datos ────────────────────────────────────────────────
POSTGRES_USER=cyberremote
POSTGRES_PASSWORD=cyberremote
POSTGRES_DB=cyberremote
DATABASE_URL=postgresql+asyncpg://cyberremote:cyberremote@db:5432/cyberremote

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Frontend ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
MAPBOX_TOKEN=your-mapbox-public-token-here

# ─── Alertas ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id
SENDGRID_API_KEY=your-sendgrid-key
FROM_EMAIL=alerts@cyberremote.io

# ─── APIs externas (fuentes de datos) ────────────────────────────
REMOTEOK_API_URL=https://remoteok.com/api
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# ─── IA (opcional) ───────────────────────────────────────────────
OPENAI_API_KEY=your-openai-key
# o para LLM local:
OLLAMA_BASE_URL=http://localhost:11434
